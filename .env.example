# PerksCrowd UI - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or .env with real values.

# API Configuration (public - safe for browser)
NEXT_PUBLIC_API_BASE_URL="http://localhost:5254"
NEXT_PUBLIC_API_URL="http://localhost:5254"

# Pagination
NEXT_PUBLIC_PAGE_SIZE=10

# Site URL (for SEO/metadata)
# NEXT_PUBLIC_SITE_URL="https://perkscrowd.com"

# Image hosts (comma-separated, appended to allowlist)
# NEXT_PUBLIC_IMAGE_HOSTS=""
